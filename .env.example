PORT=8787

# The model picker in the UI selects a model per request (see GET /api/models
# and server/models.py) — there's no env var to force a single provider.
#
# Claude: if ANTHROPIC_API_KEY is set below, Claude requests use the API
# directly. If it's unset, Claude requests automatically fall back to
# agent-sdk mode (a local `claude` CLI login) instead. See CLAUDE.md
# "Backend provider switch" before relying on the agent-sdk fallback.
ANTHROPIC_API_KEY=

# Only used for the agent-sdk fallback above (i.e. when ANTHROPIC_API_KEY is
# unset). Must be a model string this installed version of the Python
# claude-agent-sdk package documents as valid.
AGENT_SDK_MODEL=claude-opus-4-8

# Required for the OpenAI models in the picker (GPT-4o, GPT-4o mini, GPT-5.6
# Luna). Models are marked unavailable in the picker until this is set —
# there's no local-CLI fallback for OpenAI the way there is for Claude.
OPENAI_API_KEY=

# Fallback model used only if a request omits `model` entirely (the UI
# always sends one from GET /api/models, so this mainly matters for direct
# API calls). Individual OpenAI models are otherwise chosen from the catalog
# in server/src/models.ts.
OPENAI_MODEL=gpt-4o

# MongoDB connection string for user accounts and saved conversations
# (database name is always "chart-chatbot", see server/db.py). Required —
# there is no in-memory fallback: no Mongo means login and history are down.
MONGODB_URI=mongodb://localhost:27017

# --- Memory / retrieval layer (server/memory/) -------------------------------
# Indexes each finished turn into the `memory_units` collection so it can be
# retrieved later. Nothing reads from it during a chat turn yet — answering a
# request is unchanged. Set to 0 to turn ingest off entirely (the kill switch).
MEMORY_ENABLED=1

# Where the Harrier embedding model is cached. Downloaded once on first use
# (~300MB for the default int8 build); never committed to the repo.
MEMORY_MODEL_DIR=.cache/harrier

# Which ONNX build to load from the model repo. The int8 default is ~280MB
# resident per uvicorn worker and several times faster on CPU; "onnx/model.onnx"
# is the fp32 build (~1.1GB per worker) if retrieval quality ever needs it.
MEMORY_ONNX_FILE=onnx/model_quantized.onnx

# How many embedding forward passes may run at once. Each one occupies a thread
# from asyncio's default executor, so this bounds CPU use per worker process.
MEMORY_ENCODER_CONCURRENCY=4
